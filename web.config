<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quoting Studio — IIS + HttpPlatformHandler config.
  Same pattern as SCAPI. Adjust the three C:\Data\... paths and the FreeCAD
  path below to match this server before deploying.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
        processPath="C:\Data\QuotingStudio\quoting_studio\venv\Scripts\python.exe"
        arguments="C:\Data\QuotingStudio\quoting_studio\deployment\serve.py"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\Data\QuotingStudio\quoting_studio\logs\iis_stdout.log"
        startupTimeLimit="120"
        requestTimeout="00:05:00">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="PYTHONPATH" value="C:\Data\QuotingStudio\quoting_studio" />
        <environmentVariable name="FLASK_ENV" value="production" />
        <environmentVariable name="LIBGL_ALWAYS_SOFTWARE" value="1" />
        <environmentVariable name="FREECAD_CMD" value="C:\Program Files\FreeCAD 1.1\bin\freecadcmd.exe" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
